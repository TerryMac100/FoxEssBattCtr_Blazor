@page "/opsettings"
@using Microsoft.EntityFrameworkCore
@using BlazorBattControl.Models
@using NetDaemonMain.apps.FoxEss.FoxApiClient.Models
@inject NavigationManager NavigationManager
@inject FoxSettings m_foxSettings

@rendermode InteractiveServer

<PageTitle>Home Assistant Outputs</PageTitle>

<h1>Outputs</h1>

<hr />
@if (m_foxSettings is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row input-full-width">
        <div class="col-md-4 input-full-width">
            <EditForm method="post" Model="m_foxSettings" OnValidSubmit="UpdateDbSettings" FormName="edit" Enhance>
                <div class="mb-3">
                    <label for="description" class="form-label">HA Agile Export Rate Entity:</label>

                    <div class="label-wrap">
                        <InputText id="AgileExportRateEntityID" @bind-Value="m_foxSettings.AgileExportRateEntityID" class="form-control" />
                        <ValidationMessage For="() => m_foxSettings.AgileExportRateEntityID" class="text-danger" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">HA Agile Import Rate Entity:</label>
                    <div class="label-wrap">
                        <InputText id="AgileImportRateEntityID" @bind-Value="m_foxSettings.AgileImportRateEntityID" class="form-control" />
                        <ValidationMessage For="() => m_foxSettings.AgileImportRateEntityID" class="text-danger" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary save-cancel">Save</button>
                <button class="btn btn-primary save-cancel-right" @onclick="Cancel">Cancel</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private FoxSettings? FoxSettings { get; set; }

    private static AppDbSettings? settingsBackup;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
            if (m_foxSettings != null)
                settingsBackup = m_foxSettings.settings.Clone();
    }

    private void Cancel()
    {
        if (m_foxSettings != null && settingsBackup != null)
        {
            m_foxSettings.settings.OffPeakFlagEntityID = settingsBackup.OffPeakFlagEntityID;
            m_foxSettings.settings.BackupFlagEntityID = settingsBackup.BackupFlagEntityID;
            m_foxSettings.settings.FeedInPriorityFlagEntityID = settingsBackup.FeedInPriorityFlagEntityID;
            m_foxSettings.settings.DischargeFlagEntityID = settingsBackup.DischargeFlagEntityID;

            m_foxSettings.settings.OffPeakEnabled = settingsBackup.OffPeakEnabled;
            m_foxSettings.settings.BackupEnabled = settingsBackup.BackupEnabled;
            m_foxSettings.settings.FeedInPriorityEnabled = settingsBackup.FeedInPriorityEnabled;
            m_foxSettings.settings.DischargeEnabled = settingsBackup.DischargeEnabled;


            m_foxSettings.settings.AgileChargeFlagEntityID = settingsBackup.AgileChargeFlagEntityID;
            m_foxSettings.settings.AgileChargeThreshold = settingsBackup.AgileChargeThreshold;

            m_foxSettings.settings.AgileChargeThreshold = settingsBackup.AgileChargeThreshold;
            m_foxSettings.settings.AgileDischargeThreshold = settingsBackup.AgileDischargeThreshold;


            m_foxSettings.settings.AgileExportRateEntityID = settingsBackup.AgileExportRateEntityID;
            m_foxSettings.settings.AgileImportRateEntityID = settingsBackup.AgileImportRateEntityID;
        }
    }

    // To protect from over-posting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private void UpdateDbSettings()
    {
        m_foxSettings.SaveSettings();

        NavigationManager.NavigateTo("/");
    }
}
