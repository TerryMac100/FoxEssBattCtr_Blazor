@page "/"
@using Microsoft.EntityFrameworkCore
@using BlazorBattControl.Data

@using BlazorBattControl.FoxEss.FoxApiClient
@using BlazorBattControl.Octopus
@using System.ComponentModel
@using NetDaemon.HassModel;
@using NetDaemon.HassModel.Entities
@using NetDaemonMain.apps.FoxEss.FoxApiClient.Models

@implements IDisposable

@inject NavigationManager NavManager
@inject FoxEssMain m_foxEssMain
@inject OctopusApiClient m_octopusApiClient
@inject AgileRateValues m_agileRateValues
@inject ChargePlan m_chargePlan
@inject FoxSettings m_foxSettings
@inject IHaContext m_ha

@inject IDbContextFactory<BlazorBattControl.Data.BlazorBattControlContext> DbFactory

@rendermode InteractiveServer

<PageTitle>Charge Plan</PageTitle>
<h1>Charge Plan</h1>

@if (buttonStates is null)
{
    <p><em>Loading...</em></p>
}
else
{
   <div style="max-width: 350px;">
        <select class="form-control" style="width: 280px" value="@selected" @onchange="SetSelected">
            @foreach (var schedule in m_foxSettings.AllSchedules.OrderBy(m => m.Id))
            {
                if (schedule.Id != selected)
                {
                    <option value="@schedule.Id">@schedule.Name</option>
                }
                else
                {
                    // Select the selected schedule:
                    <option value="@schedule.Id" selected>@schedule.Name</option>
                }
            }
        </select> 
         
            
        <table style="width:auto;">            
            <tr>
                <td style="width: 100%">
                    <button class="btn btn-primary b-margin" padding=20 hidden="@editActive" @onclick="SendSchedule">Send</button>
                </td>
                <td style="white-space:nowrap;">
                    <label hidden="@editActive">@m_foxSettings.StatusMessage</label>
                </td>
            </tr>
        </table>


        <button class="btn btn-primary save-cancel" padding=20 hidden="@editShow" @onclick="SaveChanges">Save</button>   
        <button class="btn btn-primary save-cancel" padding=20 hidden="@editShow" @onclick="CancelChanges" style="float: right;">Cancel</button>

        <label class="form-check-label">
            <input class="form-check-input" type="checkbox" checked="@agileExportEnabled" @onchange="SetAgileExportEnabled" />
            Agile Export
        </label>
        <label class="form-check-label" style="float: right;">
            <input class="form-check-input" type="checkbox" checked="@agileImportEnabled" @onchange="SetAgileImportEnabled" />
            Agile Import
        </label>

        <table class="tableFixHead">
            <thead>
                <tr>
                    <th class="h-text" width="80">Period</th>
                    <th class="h-text">Charge</th>
                    <th class="h-text">Backup</th>
                    <th class="h-text">SelfUse</th>
                    <th class="h-text">Feed-In</th>
                    <th class="h-text">Dis-Chg</th>
                    <th class="h-text">Agile I/P</th>
                    <th class="h-text">Agile ExP</th>
                </tr>
            </thead>

            <tbody >
            @{
                int currentTimeSlot = m_agileRateValues.currentSeg;
                int firstTimeSlot = currentTimeSlot >= 0 && currentTimeSlot < 48 ? currentTimeSlot : 0;
            }
            @for (int displayRow = 0; displayRow < 48; displayRow++)
            {
                int row = (firstTimeSlot + displayRow) % 48;
                TimeOnly s_time = new TimeOnly(row / 2, (row % 2) * 30);
                TimeOnly e_time = new TimeOnly(row / 2, (row % 2) * 30);
                e_time = e_time.AddMinutes(29);
                    <tr>
                    @if (row == m_agileRateValues.currentSeg)
                    {
                        <td class="t-centre">
                            <label class="h-text-bold">@s_time - @e_time</label>
                        </td>
                    }
                    else
                    {
                        <td class="t-centre">
                            <label class="h-text">@s_time - @e_time</label>
                        </td>            
                    }
                    @{
                        int local_row = row;
                    }
                    @for (int x = 0; x < 5; x++)
                    {
                        int _x = x;

                        <td>
                            <label class="tool_tip_radio_button" data-toggle="tooltip" data-placement="bottom" title="@m_chargePlan.ButtonNames[x]">
                                <input @key="(scheduleValuesVersion, local_row, _x)" type="radio" class="radio_base radio_1"
                                           checked="@buttonStates[_x, local_row]"
                                        name=@row onchange="@(() => OnCheckChange(local_row, _x))" />
                            </label>
                        </td>
                    }

                    @if (row == m_agileRateValues.currentSeg)
                    {
                        <td class="t-centre">
                                <label class="h-text-bold">@m_agileRateValues.agileImport[local_row]</label>
                        </td>
                        <td class="t-centre">
                                <label class="h-text-bold">@m_agileRateValues.agileExport[local_row]</label>
                        </td>
                    }
                    else
                    {
                        <td class="t-centre">
                            <label class="h-text">@m_agileRateValues.agileImport[local_row]</label>
                        </td>
                        <td class="t-centre">
                            <label class="h-text">@m_agileRateValues.agileExport[local_row]</label>
                        </td>                                       
                    }
                </tr>
            } 
            </tbody>
        </table>
    </div>
}

@code
{
    private string? Message = null;
    private bool agileExportEnabled;
    private bool agileImportEnabled;
    private IDisposable? agileExportSubscription;
    private IDisposable? agileImportSubscription;

    protected override void OnInitialized()
    {
        var agileExportEntity = m_ha.Entity("input_boolean.agile_export_enable");
        agileExportEnabled = agileExportEntity.State == "on";
        agileExportSubscription = agileExportEntity.StateChanges().Subscribe(change =>
            _ = InvokeAsync(() =>
            {
                agileExportEnabled = change.New?.State == "on";
                if (buttonStates is not null)
                    SetScheduleValues();
                StateHasChanged();
            }));

        var agileImportEntity = m_ha.Entity("input_boolean.agile_import_enable");
        agileImportEnabled = agileImportEntity.State == "on";
        agileImportSubscription = agileImportEntity.StateChanges().Subscribe(change =>
            _ = InvokeAsync(() =>
            {
                agileImportEnabled = change.New?.State == "on";
                if (buttonStates is not null)
                    SetScheduleValues();
                StateHasChanged();
            }));
    }

    private void SetAgileExportEnabled(ChangeEventArgs e)
    {
        agileExportEnabled = e.Value is bool enabled && enabled;
        m_ha.Entity("input_boolean.agile_export_enable")
            .CallService(agileExportEnabled ? "turn_on" : "turn_off");
        SetScheduleValues();
    }

    private void SetAgileImportEnabled(ChangeEventArgs e)
    {
        agileImportEnabled = e.Value is bool enabled && enabled;
        m_ha.Entity("input_boolean.agile_import_enable")
            .CallService(agileImportEnabled ? "turn_on" : "turn_off");
        SetScheduleValues();
    }

    public void Dispose()
    {
        agileExportSubscription?.Dispose();
        agileImportSubscription?.Dispose();
    }

    private int _selected;
    private int selected 
    { 
        get
        {
            return _selected;
        }
        set 
        {
            _selected = value;
            SetScheduleValues();
        }
    }

    private bool editShow => !editActive;

    private bool editActive
    {
        get
        {
            return _selected != m_foxSettings.SelectedScheduleId;   
        }
    }

    private void SaveChanges()
    {
        m_foxSettings.selectorId = selected;

        m_foxSettings.SaveSelector();
    }

    private void CancelChanges()
    {
        selected = m_foxSettings.selectorId;
    }

    private void SetSelected(ChangeEventArgs e)
    {
        if (e.Value != null)
            selected = Convert.ToInt32(e.Value.ToString());

        InvokeAsync(() => StateHasChanged());
    }

    private void OnCheckChange(int row, int x)
    {
        if (buttonStates is null || row < 0 || row >= 48 || x < 0 || x >= 5)
            return;

        for (int mode = 0; mode < 5; mode++)
            buttonStates[mode, row] = mode == x;

        scheduleModes[row] = (FoxEssMain.MonitorSchedule)x;
        scheduleValuesVersion++;
    }

    private void SendSchedule()
    {
        m_foxEssMain.SetScheduleFromModes(scheduleModes);
    }

    void MessageChanged(object? sender, PropertyChangedEventArgs eventArgs)
    {
        InvokeAsync(() => StateHasChanged());
    }

    private bool[,] buttonStates = null;
    private FoxEssMain.MonitorSchedule[] scheduleModes = new FoxEssMain.MonitorSchedule[48];
    private int scheduleValuesVersion;

    private void SetScheduleValues()
    {
        m_chargePlan.InitializedSchedule(selected);

        bool[,] buttons = new bool[5, 48];

        using (var dbContext = DbFactory.CreateDbContext())
        {
            for (int i = 0; i < 48; i++)
            {
                var modeEntry = dbContext.Mode.Where(m => m.SchedualId == selected && m.TimeSlot == i).FirstOrDefault();

                var mode = modeEntry?.BattMode ?? (int)FoxEssMain.MonitorSchedule.SelfUsePeriod;
                if (mode < 0 || mode > 4)
                    mode = (int)FoxEssMain.MonitorSchedule.SelfUsePeriod;

                scheduleModes[i] = (FoxEssMain.MonitorSchedule)mode;
                buttons[mode, i] = true;
            }
        }

        if (agileExportEnabled)
            m_chargePlan.SetAgileExportSlots(buttons);

        if (agileImportEnabled)
            m_chargePlan.SetAgileImportSlots(buttons);

        for (int row = 0; row < 48; row++)
        {
            int selectedMode = (int)FoxEssMain.MonitorSchedule.SelfUsePeriod;
            for (int mode = 0; mode < 5; mode++)
            {
                if (buttons[mode, row])
                    selectedMode = mode;
            }

            for (int mode = 0; mode < 5; mode++)
                buttons[mode, row] = mode == selectedMode;

            scheduleModes[row] = (FoxEssMain.MonitorSchedule)selectedMode;
        }

        buttonStates = buttons;
        scheduleValuesVersion++;
    }

    private List<int>? Modes;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _selected = m_foxSettings.SelectedScheduleId;
            SetScheduleValues();

            Message = "Running";
            InvokeAsync(() => StateHasChanged());
        }
    }
}
